# GitHub Personal Access Token. Classic PAT with `public_repo` scope is enough
# for reading stars. Fine-grained token: read `metadata` for users + repos.
GITHUB_TOKEN=

# GitHub username whose stars you want to analyze (the "owner" perspective).
# Leave empty to autodetect from GITHUB_TOKEN.
GITHUB_USER=

# --- LLM provider (OpenAI-compatible) ----------------------------------------
# Works with OpenAI, Azure OpenAI, DeepSeek, Moonshot, Doubao, etc.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional Anthropic-style endpoint if you swap to the Anthropic provider
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Runtime tuning ---------------------------------------------------------
# SQLite database path (relative to project root unless absolute).
GSA_DB_PATH=data/stars.db

# README cache directory.
GSA_CACHE_DIR=data/cache

# Markdown output directory.
GSA_OUTPUT_DIR=data/output

# Path to the YAML config (overrides env vars).
GSA_CONFIG=config/config.yaml

# HTTP timeouts (seconds).
GSA_HTTP_TIMEOUT=30

# Sleep between API calls (seconds) — keep above 0 to respect rate limits.
GSA_REQUEST_SLEEP=0.05

# Max items per batch (independent of pipeline phase).
GSA_BATCH_SIZE=20

# LLM concurrency (asyncio tasks in flight at once).
GSA_LLM_CONCURRENCY=4

# Max retry attempts for any HTTP call.
GSA_MAX_RETRIES=3

# Output language for generated Markdown. `zh-CN` or `en`.
GSA_OUTPUT_LANG=zh-CN